{
  "name": "learning-desk",
  "version": "1.0.0",
  "description": "Mesa de Estudos: dois PDFs, calculadora e Pi numa janela, ao lado do Xournal++",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=180000 --test-force-exit tests/*.test.mjs",
    "pretest": "node scripts/core-gate.mjs",
    "check": "node tests/syntax-check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build:bend": "node ../core/build-safe.mjs",
    "test:proof": "node ../core/proof.mjs",
    "test:parity": "node tests/parity.mjs",
    "hunts": "node tests/run-hunts.mjs",
    "ui": "node tests/run-ui.mjs",
    "verify:bend": "node ../core/verify.mjs",
    "test:pi": "node tests/pi-contract.mjs",
    "test:ui:x3": "node tests/smoke-x3.mjs",
    "test:app": "node tests/app-smoke.mjs",
    "test:packaged": "node tests/packaged-app-ui.mjs",
    "test:watchdog": "node tests/watchdog-ui.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "geogebra:offline": "node scripts/geogebra-offline.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:claude": "node scripts/claude-doctor.mjs",
    "triage": "node scripts/triage.mjs",
    "test:claude-ui": "node tests/run-claude-ui.mjs",
    "profile": "node scripts/profile.mjs",
    "install-app": "node scripts/install-app.mjs",
    "update": "node scripts/update-cli.mjs",
    "test:sessions": "node tests/session-switch.mjs"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "chart.js": "4.5.1",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "10.12.0",
    "globals": "17.4.0",
    "typescript": "7.0.2"
  },
  "productName": "Mesa de Estudos"
}
