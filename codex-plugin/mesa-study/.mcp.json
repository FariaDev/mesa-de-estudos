{
  "mcpServers": {
    "mesa": {
      "command": "node",
      "args": [
        "./server/main.mjs"
      ],
      "cwd": "./",
      "env_vars": [
        "MESA_STUDY_ROOTS",
        "MESA_STUDY_CACHE_DIR",
        "MESA_XOURNAL_HELPER",
        "MESA_STUDY_MAX_IMAGE_BYTES",
        "MESA_STUDY_TUTOR_FILE",
        "MESA_STUDY_LEARNER_FILE",
        "MESA_STUDY_STATE_FILE"
      ]
    }
  }
}
