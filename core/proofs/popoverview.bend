# Indução: cada opção vira exatamente uma linha contada.
def Laws.pv_contagem_opcoes(options):
  match options:
    case Nil{}:
      {==}
    case Con{h, t}:
      match h:
        case P.PopOption{+key, +label, +hint, +current, active, +pinned}:
          %Equal.sym(Nat, P.modelOptionCount([P.PopGroup{"g", t}]), List.length(&2, P.PopOption, t), Laws.pv_contagem_opcoes(t)) : {Nat.add(1n, _) == Nat.add(1n, List.length(&2, P.PopOption, t)) : Nat}
          {==}
